@article{boucheron2015,
  author  = {Boucheron, St{\'e}phane and Thomas, Maud},
  title   = {Tail index estimation, concentration and adaptivity},
  journal = {Electronic Journal of Statistics},
  volume  = {9},
  number  = {2},
  pages   = {2751--2792},
  year    = {2015},
  doi     = {10.1214/15-EJS1088},
  note    = {Preprint arXiv:1503.05077, read in full. Section 1 gives the Hill estimator in the
             form implemented, the mean of ln(X_(i)/X_(k+1)) over the k largest order
             statistics, and states that it converges to the extreme-value index gamma for every
             k with k to infinity and k/n to 0 exactly when the tail is in the domain of
             attraction with gamma > 0. The copy read shows no number on that definition, so the
             section is cited. Section 2.3 mentions alternative Hill plots; it does not define
             one, and this bundle's logarithmic coordinate in k is not attributed to it}
}

@article{clauset2009,
  author  = {Clauset, Aaron and Shalizi, Cosma Rohilla and Newman, M. E. J.},
  title   = {Power-Law Distributions in Empirical Data},
  journal = {SIAM Review},
  volume  = {51},
  number  = {4},
  pages   = {661--703},
  year    = {2009},
  doi     = {10.1137/070710111},
  note    = {Preprint arXiv:0706.1062v2 (PDF, equations numbered by section), read in full.
             Eq. (1.1) defines alpha as the exponent of the density, p(x) proportional to
             x^-alpha. Eq. (3.1) is the continuous power-law maximum-likelihood estimator, stated
             there to be equivalent to Hill's; the card writes out the map, alpha - 1 = 1/H(k)
             with the k values above x_min = X_(k+1). Section 3.5
             names the Hill plot and the fixed rule this bundle registers, keeping the largest
             sqrt(n) observations; Section 3.3 and Eq. (3.9) give the Kolmogorov-Smirnov choice
             of the threshold that this bundle does not use, and Sections 4 and 5 the test of
             whether a power law fits at all}
}

