@misc{arnold2015,
  author       = {Arnold, Douglas N.},
  title        = {Lecture Notes on Numerical Analysis of Partial Differential Equations},
  howpublished = {University of Minnesota, MATH 8445-8446,
                  \url{https://www-users.cse.umn.edu/~arnold/8445-8446.14-15/notes.pdf}},
  year         = {2015},
  note         = {Chapter 4 read in full text on 2026-11-04. The H^r seminorm on an element is
                  the integral of the squared derivatives of order r, with no division by the
                  element's size (the display before Theorem 4.6); Eq. (4.3) is Galerkin
                  orthogonality; Theorem 4.6 bounds the interpolation error |u - I_h u|_1 by
                  c h^(s-1) |u|_s; Eq. (4.10) is the a priori estimate ||u - u_h||_1 <= c h^r
                  ||u||_(r+1) in the full norm}
}

