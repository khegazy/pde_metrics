@article{szekely2013,
  author  = {Sz{\'e}kely, G{\'a}bor J. and Rizzo, Maria L.},
  title   = {Energy statistics: A class of statistics based on distances},
  journal = {Journal of Statistical Planning and Inference},
  volume  = {143},
  number  = {8},
  pages   = {1249--1272},
  year    = {2013},
  doi     = {10.1016/j.jspi.2013.03.018},
  note    = {Definition 1, Eq. (2.4): the squared form 2E|X-Y| - E|X-X'| - E|Y-Y'|, which
             this paper calls the energy distance. The display immediately before Eq. (2.3):
             on the line it equals 2 times the integral of (F-G)^2. Eq. (6.1): the two-sample
             V-statistic over all pairs; Sect. 1: V-statistics are used because they are
             nonnegative. Proposition 2, Eqs. (5.1)-(5.2): the exponent alpha in (0, 2), fixed
             at 1 here}
}

@article{rizzo2016,
  author  = {Rizzo, Maria L. and Sz{\'e}kely, G{\'a}bor J.},
