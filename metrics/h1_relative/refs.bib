@misc{neuraloperator2026,
  author       = {{The neuraloperator developers}},
  title        = {neuraloperator: {Learning} in Infinite Dimensions with Neural Operators},
  howpublished = {\url{https://github.com/neuraloperator/neuraloperator}},
  year         = {2026},
  note         = {Read 2026-11-04 at commit 0c10234 (2026-02-24). neuralop/losses/data_losses.py,
                  H1Loss: compute_terms (the field and its first derivatives, flattened over
                  space), uniform_quadrature (h_j = measure / N_j, measure = 1.0 by default),
                  rel (sqrt of the summed squared differences over sqrt of the target's sums plus
                  eps = 1e-8), reduce_all (sum over batch and channels by default) and __call__
                  (returns rel). neuralop/losses/differentiation.py, FiniteDiff: periodic centred
                  differences (f[i+1] - f[i-1]) / (2h) by torch.roll; third-order one-sided
                  differences at non-periodic boundaries. neuralop/training/trainer.py, evaluate:
                  each loss summed over batches and divided by the number of samples.
                  scripts/train_navier_stokes.py line 157 and scripts/train_darcy.py line 148:
                  h1loss = H1Loss(d=2)}
}

