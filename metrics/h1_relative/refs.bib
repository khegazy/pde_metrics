  title     = {Learning Chaotic Dynamics in Dissipative Systems},
  booktitle = {Advances in Neural Information Processing Systems 35},
  pages     = {16768--16781},
  year      = {2022},
  eprint    = {2106.06898},
  archivePrefix = {arXiv},
  note      = {Sect. 3, "Sobolev norm as loss", Eq. (3): the Sobolev norm of the one-step error
               with the sum over derivative orders starting at 0 (inhomogeneous); Eq. (4): its
               Fourier form. Sect. 4, "Accuracy with respect to various norms": models trained
               with relative H^0, H^1 and H^2 losses and measured in the standard norms. App.
               A.3, Table 3 (Kolmogorov flow, Re = 40): an "H^1 error" column; Table 5
               (Re = 5000): a "Testing H^1" column. Numbering read from the arXiv source and
               checked against the proceedings PDF. The paper does not state that the reported
               H^1 error is relative; the authors' code (HsLoss, markov_neural_operator
               utilities.py) computes it relative, with spectral weights}
}

