@article{peyre2018,
  author  = {Peyre, R{\'e}mi},
  title   = {Comparison between {$W_2$} distance and {$\dot{H}^{-1}$} norm, and
             localization of {W}asserstein distance},
  journal = {ESAIM: Control, Optimisation and Calculus of Variations},
  volume  = {24},
  number  = {4},
  pages   = {1489--1501},
  year    = {2018},
  doi     = {10.1051/cocv/2017050},
  note    = {Preprint arXiv:1104.4631v2. Equation (5) there is the infinitesimal
             linearization W_2(mu, mu + dmu) = ||dmu||_{Hdot^-1(mu)} + o(dmu), and
             Theorem 1 the non-asymptotic upper bound W_2(mu, nu) <= 2 ||mu - nu||_
             {Hdot^-1(mu)}. Both norms there are weighted by mu; the unweighted
             Hdot^-1(dx) computed here is related to them through the density bounds,
             which is the caveat recorded in the card's Limitations. Equation and theorem
             numbers are taken from the arXiv version, the one that could be read: the
             publisher's page returns 403}
}

