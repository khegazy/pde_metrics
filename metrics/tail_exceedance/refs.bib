@misc{jwgfvr,
  author       = {{WWRP/WCRP Joint Working Group on Forecast Verification Research}},
  title        = {Forecast verification: methods, issues and {FAQ}},
  howpublished = {Web page of the JWGFVR, formerly hosted at cawcr.gov.au/projects/verification},
  url          = {https://jwgfvr.github.io/forecastverification},
  note         = {Read on 2026-10-31 in a fetch of the first 100,000 of the page's 141,777
                  characters, which hold the cited section. Section "Frequency bias (bias score)", under methods
                  for dichotomous forecasts: (hits + false alarms) / (hits + misses), the
                  frequency of forecast events over the frequency of observed events, range 0 to
                  infinity, perfect score 1, below 1 under-forecasting and above 1
                  over-forecasting, and no measure of correspondence. The page numbers no
                  equations, so the section is cited. This bundle's number is that score, with
                  the reference as the observation; its target of 1 is the perfect score}
}

@misc{etccdi,
  author       = {{CCl/CLIVAR Expert Team on Climate Change Detection and Indices}},
  title        = {Climate Change Indices: Definitions of the 27 core indices},
  howpublished = {ETCCDI web page, last updated 2009-09-15},
  url          = {https://etccdi.pacificclimate.org/list_27_indices.shtml},
  note         = {Read in full on 2026-10-31. Items 10 (TN10p) and 13 (TX90p): the percentage of
                  days whose value exceeds a percentile computed from a base period. The precedent
                  for this bundle's event, an exceedance of a threshold set by the reference
                  sample's own percentile, with the reference in the place of the base period.
                  The indices use a strict inequality (TXij > TXin90); this bundle's non-strict
                  one is its own choice}
}

@article{zhang2005,
  author  = {Zhang, Xuebin and Hegerl, Gabriele and Zwiers, Francis W. and Kenyon, Jesse},
  title   = {Avoiding Inhomogeneity in Percentile-Based Indices of Temperature Extremes},
  journal = {Journal of Climate},
  volume  = {18},
  number  = {11},
  pages   = {1641--1651},
  year    = {2005},
  doi     = {10.1175/JCLI3366.1},
  note    = {Read through its abstract only (Crossref record). Exceedance rates of a percentile
             threshold differ inside and outside the sample the threshold was estimated from,
             because of sampling error in the threshold. The same effect is why this bundle
             takes the k-th largest reference increment with a non-strict inequality; the
             expected value for an independent candidate is derived on the card, not taken
             from this paper}
}

