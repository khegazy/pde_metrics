@article{taha2015,
  author  = {Taha, Abdel Aziz and Hanbury, Allan},
  title   = {Metrics for evaluating {3D} medical image segmentation: analysis, selection, and
             tool},
  journal = {BMC Medical Imaging},
  volume  = {15},
  pages   = {29},
  year    = {2015},
  doi     = {10.1186/s12880-015-0068-x},
  note    = {The registered number: the Dice coefficient, Eq. (6), 2|A n B|/(|A| + |B|). Also
             the Jaccard index, Eq. (7), and the identities relating the two, Eqs. (8)-(9),
             with the remark that they give the same ranking; the equality of Dice and the F1
             measure (Table 1); and the warning that overlap scores a non-overlapping near miss
             the same as a far one. Read in the PMC copy PMC4533825}
}

@article{maierhein2024,
  author  = {Maier-Hein, Lena and Reinke, Annika and Godau, Patrick and Tizabi, Minu D. and
             others},
  title   = {Metrics reloaded: recommendations for image analysis validation},
  journal = {Nature Methods},
  volume  = {21},
  pages   = {195--212},
  year    = {2024},
  doi     = {10.1038/s41592-023-02151-z},
  note    = {The choice of Dice over the Jaccard index as a preference only: the main-text
             Results recommend "the DSC or IoU" by default for semantic segmentation and call
             the choice between them "a simple user or community preference" (Step 2), and
             Suppl. Note 2.3 names the DSC as its default, almost identical to the IoU. Its rule
             in Suppl. Note 2.3 that an undefined value takes the worst possible value is the
             alternative to this bundle's both-empty convention recorded in issue 120. Read in
             the arXiv HTML copy 2206.01653v8 through a summarising fetch tool; the published
             version (PMC11182665) uses the same supplementary numbering, as checked by this
             bundle's reviewer}
}

