@misc{metricsreloadedcode,
  author       = {{Metrics Reloaded consortium}},
  title        = {{MetricsReloaded}: metrics/pairwise\_measures.py},
  howpublished = {GitHub repository Project-MONAI/MetricsReloaded, branch main},
  url          = {https://github.com/Project-MONAI/MetricsReloaded/blob/main/MetricsReloaded/metrics/pairwise_measures.py},
  note         = {Read (raw source, 2026-11-04): measured_distance returns NaN for every distance
                  when the prediction or the reference is empty, warning "need to set to worse case
                  in aggregation"; measured_hausdorff_distance_perc is the maximum of the two
                  directed np.percentile values, default 95; measured_masd is 0.5 * (mean of one
                  directed set of border distances + mean of the other); dsc returns NaN when both
                  are empty, warning that it "can be set to 1 when aggregating". Borders come from
                  MorphologyOps.border_map, not read}
}

@misc{medpy,
  author       = {Maier, Oskar},
  title        = {{MedPy}: medpy/metric/binary.py},
  howpublished = {GitHub repository loli/medpy, branch master},
  url          = {https://github.com/loli/medpy/blob/master/medpy/metric/binary.py},
  note         = {Read (raw source, 2026-11-04): hd is the maximum of the two directed maxima;
                  hd95 is numpy.percentile of the two directions' distances pooled, at 95; assd
                  pools both directions; surface distances are taken between borders extracted by
                  one binary erosion; an empty mask raises RuntimeError}
}

@misc{spatialvx,
  author       = {Gilleland, Eric},
  title        = {{SpatialVx}: Spatial Forecast Verification, functions locmeasures2d and locperf},
  howpublished = {R package documentation and source},
  url          = {https://www.rdocumentation.org/packages/SpatialVx/versions/1.0-3/topics/locmeasures2d},
  note         = {Read: the documentation of locmeasures2d (measures "bdelta", "haus", "med",
                  "ph" among others; p = 2 by default; Baddeley's delta as the L^p norm of
                  |w(d(x,A)) - w(d(x,B))| over the grid with w(t) = min(t, c); the Hausdorff
                  distance as the largest |d(x,A) - d(x,B)| over the grid; the partial Hausdorff
                  distance as the k-th largest value, or a quantile for 0 < k < 1) and the source
                  R/LocMeasures.R of the CRAN mirror (bdconst set to Inf when NULL; "bdelta" and
                  "haus" computed by spatstat's deltametric, the latter with p = Inf and c = Inf;
                  in locperf, "ph" as the larger of the two fields' k-th largest distances; in
                  distob, 0 when both fields have no event and the larger grid dimension when one
                  has none). Cites Gilleland (2011), doi 10.1175/WAF-D-10-05061.1}
}
