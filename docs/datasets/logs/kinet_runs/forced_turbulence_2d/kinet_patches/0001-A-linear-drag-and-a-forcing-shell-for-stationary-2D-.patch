+def test_a_negative_constant_rate_is_a_drag_on_the_fluctuation() -> None:
+    """A negative rate removes kinetic energy and adds no net momentum, its half step
+    solves ``F(u) = F0 + rho K u`` at that rate, and the LBM step accepts it."""
+    rate = -2.0e-3
+    law = forcing_law(
+        f"{{type: linear, rate: {rate!r}}}", grid=(4, 5), kind=LinearForcingTerm
+    )
+    fields = momentum_fields((4, 5))
+    density, velocity = fields["density"], fields["velocity"]
+
+    force = _force(law, fields)
+    source = law.half_step_source(fields, step=0)
+
+    torch.testing.assert_close(
+        force, rate * density * (velocity - favre_mean(density, velocity))
+    )
+    momentum_input = force.sum(dim=(2, 3))
+    torch.testing.assert_close(
+        momentum_input, torch.zeros_like(momentum_input), atol=2.0e-15, rtol=0.0
+    )
+    assert torch.all((velocity * force).sum(dim=(1, 2, 3)) < 0.0)
+    assert source is not None and source.force is not None
+    torch.testing.assert_close(source.force + density * rate * velocity, force)
+    law.validate_time_step(1.0)
+
+
