+def test_minimum_mode_confines_the_force_to_a_shell() -> None:
+    """With ``minimum_mode`` the forced modes are those of the ball at or beyond the inner
+    radius, the acceleration has no Fourier content inside it, a carry of the ball law
+    does not resume the shell law, and an empty shell is refused."""
+    ball = _law((16, 16), maximum_mode=3.0)
+    shell = _law((16, 16), maximum_mode=3.0, minimum_mode=2.0)
+    ball_radii = ball.mode_indices.square().sum(dim=1)
+
+    assert torch.equal(shell.mode_indices, ball.mode_indices[ball_radii >= 4])
+    fields = momentum_fields((16, 16), nonuniform=False)
+    sources, _ = _evaluate(shell, fields)
+    spectrum = torch.fft.fftn(sources["momentum"] / fields["density"], dim=(2, 3))
+    index = torch.fft.fftfreq(16, d=1.0 / 16, dtype=torch.float64)
+    inside = index[:, None] ** 2 + index[None, :] ** 2 < 4
+    assert spectrum[..., inside].abs().amax() < 2.0e-10
+    _, ball_state = _evaluate(ball, fields)
+    with pytest.raises(ValueError, match="settings do not match"):
+        shell.load_checkpoint_state({"carry": ball_state})
+    with pytest.raises(ValueError, match="selects no nonzero"):
+        _law((8, 8, 8), maximum_mode=1.3, minimum_mode=1.1)
+
+
